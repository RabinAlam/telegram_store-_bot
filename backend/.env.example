# TZ Store backend — copy to backend/.env (or root .env for docker-compose)
PORT=4000
DATABASE_URL=postgresql://tz:tzsecret@localhost:5432/tzstore
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-32-chars-minimum

# Telegram bot (grammY webhook mode)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBAPP_URL=https://tz-store.example.com
API_PUBLIC_URL=http://localhost:4000
ADMIN_NOTIFY_CHAT_ID=
SUPPORT_URL=https://t.me/TZStoreSupport
CHANNEL_URL=https://t.me/TZStoreChannel

# Personal Binance account (no merchant needed) — buyers send USDT to this UID
BINANCE_UID=1134278389
# Spot API key/secret (api.binance.com → API Management → Enable Spot; restrict IP) for auto-verify
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_SECRET=
# Binance Pay merchant (OPTIONAL — only if you have a merchant account)
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_SANDBOX=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
